<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configurazione per IIS (hosting Windows, es. Aruba). Va nella root del sito.
  Contiene: HTTPS e www obbligatori, redirect dei vecchi URL del sito 2021, header di sicurezza,
  MIME per .webp/.woff2 (IIS 10 non li conosce di serie), cache, pagina 404.
  Richiede il modulo "URL Rewrite" (presente sugli hosting Aruba Windows; in caso contrario togliere <rewrite>).
  Se l'hosting rifiuta alcuni elementi (errore 500.19), commentarli uno alla volta.
-->
<configuration>
  <system.webServer>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <!-- vecchie pagine del sito 2021 -> nuove pagine (redirect permanente, si mantiene il posizionamento) -->
        <rule name="old-fitness" stopProcessing="true">
          <match url="^(fitness|altre[ %].*|gallery)\.html$" ignoreCase="true" />
          <action type="Redirect" url="https://www.colosseumazzate.it/la-palestra.html" redirectType="Permanent" />
        </rule>
        <rule name="old-abbonamenti" stopProcessing="true">
          <match url="^abbonamenti[ %]2021\.html$" ignoreCase="true" />
          <action type="Redirect" url="https://www.colosseumazzate.it/abbonamenti.html" redirectType="Permanent" />
        </rule>
        <rule name="old-dovesiamo" stopProcessing="true">
          <match url="^dove_siamo\.html$" ignoreCase="true" />
          <action type="Redirect" url="https://www.colosseumazzate.it/dove-siamo.html" redirectType="Permanent" />
        </rule>
        <rule name="old-index" stopProcessing="true">
          <match url="^index[ %]2021\.html$" ignoreCase="true" />
          <action type="Redirect" url="https://www.colosseumazzate.it/" redirectType="Permanent" />
        </rule>
        <!-- un solo salto verso https://www. -->
        <rule name="canonical-host" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="off" />
            <add input="{HTTP_HOST}" pattern="^colosseumazzate\.it$" />
          </conditions>
          <action type="Redirect" url="https://www.colosseumazzate.it/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml" />
      <!-- HTML: sempre riconvalidato (10 minuti) -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:10:00" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="Content-Security-Policy" value="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true" />
    </security>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

  </system.webServer>

  <!-- immagini e font cambiano di rado: cache lunga -->
  <location path="assets/img">
    <system.webServer>
      <staticContent><clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" /></staticContent>
    </system.webServer>
  </location>
  <location path="assets/fonts">
    <system.webServer>
      <staticContent><clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" /></staticContent>
    </system.webServer>
  </location>
  <!-- CSS e JS: 1 giorno (non hanno il hash nel nome) -->
  <location path="assets/css">
    <system.webServer>
      <staticContent><clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" /></staticContent>
    </system.webServer>
  </location>
  <location path="assets/js">
    <system.webServer>
      <staticContent><clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" /></staticContent>
    </system.webServer>
  </location>
</configuration>
